# Copy the relevant settings into .env. Never commit API keys.
# Use exact model IDs and base URLs offered by YOUR API provider.
# Suggested roles: A = DeepSeek V4.1 Flash; B = Step 5 Preview; judge = Kimi K3.
# Reasoning effort is explicitly set to high for A, B and judge.
# Leave TEMPERATURE empty to omit the field (not 0 or JSON null) and use provider defaults.
# Only set a number when the selected provider/model/mode explicitly supports it.
# TIMEOUT limits connection, sending and pool waits; response reads have no deadline.
# SLOW_WARNING_SECONDS warns after inactivity; it never stops a model request.

GENERATOR_A_NAME=
GENERATOR_A_API_KEY=
GENERATOR_A_BASE_URL=
GENERATOR_A_TEMPERATURE=
GENERATOR_A_TIMEOUT=90
GENERATOR_A_SLOW_WARNING_SECONDS=90
GENERATOR_A_MAX_TOKENS=8192
GENERATOR_A_TOKEN_LIMIT_FIELD=max_tokens
GENERATOR_A_JSON_MODE=false
GENERATOR_A_EXTRA_BODY={"reasoning_effort":"high"}

GENERATOR_B_NAME=
GENERATOR_B_API_KEY=
GENERATOR_B_BASE_URL=
GENERATOR_B_TEMPERATURE=
GENERATOR_B_TIMEOUT=90
GENERATOR_B_SLOW_WARNING_SECONDS=90
GENERATOR_B_MAX_TOKENS=8192
GENERATOR_B_TOKEN_LIMIT_FIELD=max_tokens
GENERATOR_B_JSON_MODE=false
GENERATOR_B_EXTRA_BODY={"reasoning_effort":"high"}

JUDGE_NAME=
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_TEMPERATURE=
JUDGE_TIMEOUT=90
JUDGE_SLOW_WARNING_SECONDS=90
JUDGE_MAX_TOKENS=8192
JUDGE_TOKEN_LIMIT_FIELD=max_tokens
JUDGE_JSON_MODE=false
JUDGE_EXTRA_BODY={"reasoning_effort":"high"}

# Optional legacy settings for --mode quick. If all three are empty, quick uses A.
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TEMPERATURE=
MODEL_TIMEOUT=90
MODEL_MAX_TOKENS=8192
MODEL_TOKEN_LIMIT_FIELD=max_tokens
MODEL_JSON_MODE=false
MODEL_EXTRA_BODY={}
